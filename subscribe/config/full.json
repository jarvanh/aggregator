            },
            "full-v2ray": {
                "username": "jarvanh",
                "gistid": "__GIST_ID__",
                "filename": "full-v2ray.txt"
            },
            "crawledsubs": {
                "username": "jarvanh",
                "gistid": "__GIST_ID__",
                "filename": "crawledsubs.json"
            },
            "crawledproxies": {
                "username": "jarvanh",
