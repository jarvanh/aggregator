                        "full"
                    ]
                },
                "SOSkeyNET": {
                    "include": "",
                    "exclude": "",
                    "push_to": [
                        "full"
                    ]
                },
                "v2rayprotocol": {
                    "include": "",
                    "exclude": "",
                    "push_to": [
                        "full"
                    ]
                }
